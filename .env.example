# Gemini API Key (Required for AI operations)
GEMINI_API_KEY=

# CryptoCompare API Key (Optional, for live crypto news feed)
CRYPTOCOMPARE_API_KEY=

# Firebase Client API Key (Optional, for Firebase authentication/storage)
FIREBASE_API_KEY=

# ---------------------------------------------------------------------------
# MAGGI RAG engine (optional — the engine falls back gracefully without these)
# ---------------------------------------------------------------------------

# FreeLLMAPI brain: https://github.com/tashfeenahmed/freellmapi
# Run it locally (`npx freellmapi` → http://localhost:3001), then either paste
# the unified key in MAGGI → Settings (browser only) or set it here so the key
# never touches the client.
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=

# Server Configuration
PORT=3000
NODE_ENV=development
