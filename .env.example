# ─── Gemini (primary brain + audio/TTS) ─────────────────────────────────────
# Required for text generation, context caching and TTS (all audio in the app).
GEMINI_API_KEY=

# ─── FreeLLMAPI (MAGGI) key pool ─────────────────────────────────────────────
# OpenAI-compatible. The app reads either FREELLMAPI_* or MAGGI_FREELLM_*.
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
# Optional JSON: [{"key":"k1"},{"key":"k2"}] — multiple keys rotate round-robin.
FREELLMAPI_KEYS_JSON=

# ─── Ollama (local/remote brain) ─────────────────────────────────────────────
# The app-side default is http://localhost:11434 (set in the UI; no env needed).
# OLLAMA_ORIGINS="*"  — required on the remote server to allow browser CORS.

# ─── Crypto compare (finance tools) ─────────────────────────────────────────
# Optional; enables/enriches crypto price data.
CRYPTOCOMPARE_API_KEY=

# ─── Firebase web config (session cloud sync; public by design) ──────────────
# All optional: without these, the app falls back to localStorage/IndexedDB.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
